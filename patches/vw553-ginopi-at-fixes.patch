+ble_status_t app_adv_stop_all(bool rmv_adv)
+{
+    ble_status_t result = BLE_ERR_NO_ERROR;
+
+    for (uint8_t i = 0; i < APP_ADV_SET_NUM; i++) {
+        if (app_adv_env.adv_set[i].idx == ADV_INVALID_IDX) {
+            continue;
+        }
+        ble_status_t ret = app_adv_stop(app_adv_env.adv_set[i].idx, rmv_adv);
+        if (ret != BLE_ERR_NO_ERROR) {
+            result = ret;
+        }
+    }
+
+    return result;
+}

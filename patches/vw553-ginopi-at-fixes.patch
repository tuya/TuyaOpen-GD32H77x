-int at_parse_ip4(char *str, uint32_t *ip)
-{
-    char *token;
-    uint32_t a, i, j;
-
-    token = strchr(str, '/');
-    *ip = 0;
-
-    for (i = 0; i < 4; i++) {
-        if (i < 3) {
-            token = strchr(str, '.');
-            if (!token)
-                return -1;
-            *token++ = '\0';
-        }
-        for (j = 0; j < strlen(str); j++) {
-            if (str[j] < '0' || str[j] > '9')
-            return -1;
-        }
-
-        a = atoi(str);
-        if (a > 255)
-            return -1;
-        str = token;
-        *ip += (a << (i * 8));
-    }
-
-    return 0;
-}

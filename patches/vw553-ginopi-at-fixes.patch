+/*!
+    \brief      initialize structure of tcpip information
+    \param[in]  none
+    \param[out] none
+    \retval     none
+*/
+void cip_info_init(void)
+{
+    int i, s;
+
+    cip_task_terminate = 0;
+
+    sys_memset(&cip_info, 0, sizeof(cip_info));
+    cip_info.trans_intvl = CIP_TRANSFER_INTERVAL_DEFAULT; //ms
+    for (s = 0; s < MAX_SERVER_NUM; s++) {
+        cip_info.srv[s].fd = -1;
+    }
+    for (i = 0; i < MAX_CLIENT_NUM; i++) {
+        cip_info.cli[i].fd = -1;
+    }
+    cip_info.next_cli_generation = 0;
+    cip_info.last_free_fd = -1;
+    cip_info.last_free_con_id = -1;
+    cip_info.last_free_generation = 0;
+    return;

-{
-    int i = 0, j = 0;
-    while (src[i] != '\0' && j < max_len - 1) {
-        if (src[i] == '\\' && src[i+1] == 'r' && src[i+2] == '\\' && src[i+3] == 'n') {
-            dst[j++] = '\r';
-            dst[j++] = '\n';
-            i += 4;
-        } else if (src[i] == '\\' && src[i+1] == 'n') {
-            dst[j++] = '\n';
-            i += 2;
-        } else if (src[i] == '\\' && src[i+1] == 'r') {
-            dst[j++] = '\r';
-            i += 2;
-        } else {
-            dst[j++] = src[i++];
-        }
-    }
-    dst[j++] = '\0';
-    return j;

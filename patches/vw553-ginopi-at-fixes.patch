+/*!
+    \brief      stop the listener bound to a port and notify the host
+    \param[in]  srv_port: listening port
+    \retval     0 on success, -1 when no matching listener exists
+*/
+static int tcp_udp_server_stop_port(uint16_t srv_port)
+{
+    int i, s, fd, cli_fd;
+
+    for (s = 0; s < MAX_SERVER_NUM; s++) {
+        if ((cip_info.srv[s].fd >= 0) && (cip_info.srv[s].port == srv_port)) {
+            break;
+        }
+    }
+    if (s == MAX_SERVER_NUM) {
+        AT_TRACE("No matching server.\r\n");
+        return -1;
+    }
+
+    fd = cip_info.srv[s].fd;
+    for (i = 0; i < MAX_CLIENT_NUM; i++) {
+        if ((cip_info.cli[i].fd >= 0) && (cip_info.cli[i].listener_fd == fd)) {
+            cli_fd = cip_info.cli[i].fd;
+            cip_info_cli_free_reason(i, "SERVER_STOP");
+            close(cli_fd);
+        }
+    }
+    cip_info.srv[s].fd = -1;
+    cip_info.srv[s].port = 0;
+    cip_info.srv[s].stop = 0;
+    close(fd);
+    return 0;
+}
+
+/*!
+    \brief      close every listener and the clients accepted by them
+    \param[in]  none
+    \param[out] none
+    \retval     none
+
+    A SoftAP listener is bound to the AP vif.  When the default vif switches to
+    STA the sockets cannot survive, but the host's
+    AT+TY553XSERVER=<kind>,<port>,0 command shares the AT task with CWJAP and
+    can time out before it is even parsed.  Closing them here makes the vif
+    transition authoritative instead of leaving a server slot allocated.
+*/
+void at_cip_stop_all_listeners(void)
+{
+    int i, s;
+
+    for (s = 0; s < MAX_SERVER_NUM; s++) {
+        int fd = cip_info.srv[s].fd;
+
+        if (fd < 0) {
+            continue;
+        }
+        for (i = 0; i < MAX_CLIENT_NUM; i++) {
+            if ((cip_info.cli[i].fd >= 0) &&
+                ((cip_info.cli[i].listener_fd == fd) ||
+                 (cip_info.cli[i].role == CIP_ROLE_SERVER))) {
+                int cli_fd = cip_info.cli[i].fd;
+                cip_info_cli_free_reason(i, "SERVER_STOP");
+                close(cli_fd);
+            }
+        }
+        close(fd);
+        cip_info.srv[s].fd = -1;
+        cip_info.srv[s].port = 0;
+        cip_info.srv[s].stop = 0;
+    }
+    /* srv[0] aliases local_srv_*; the loop above already cleared it. */
+    cip_info.local_srv_stop = 0;
+}

 /*!
+    \brief      Stop all advertising sets
+    \param[in]  rmv_adv: true to remove advertising set after it is stopped, otherwise false
+    \param[out] none
+    \retval     ble_status_t: BLE_ERR_NO_ERROR on success, otherwise an error code

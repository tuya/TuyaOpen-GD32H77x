-        AT_TRACE("Bind server socket fd error!\r\n");
-        goto Exit;
-    }
-    AT_TRACE("Bind successfully.\r\n");
-
-    if (type == CIP_TYPE_TCP) {
-        /* putting the socket for listening to the incoming TCP connection */

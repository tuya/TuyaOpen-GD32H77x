+void at_https_recvdata_process(int argc, char **argv)
+{
+    int recv_len;
+    struct recv_data_node *p_item;
+    uint8_t *data_remain = NULL;
+
+extern struct list send_2_mcu_data_list;
+extern os_mutex_t send_2_mcu_data_list_lock;
+
+    AT_RSP_START(RDU_SERVER_MAX_RECV_DATA_SIZE + 30);
+    if (argc == 2) {
+        if (argv[1][0] == AT_QUESTION) {
+            goto Usage;
+        } else {
+            if (!list_is_empty(&send_2_mcu_data_list)) {
+                recv_len = atoi(argv[1]);
+                if (recv_len < 0 || recv_len > RDU_SERVER_MAX_RECV_DATA_SIZE) {
+                    app_print("recv_len:%d error\r\n", recv_len);
+                    goto Error;
+                }
+
+                sys_mutex_get(&send_2_mcu_data_list_lock);
+                p_item = (struct recv_data_node *)list_pop_front(&send_2_mcu_data_list);
+
+                if ((p_item != NULL) && p_item->data && (p_item->data_len > 0)) {
+                    if (p_item->data_len <= recv_len) { // data length is smaller than request data length
+                        // AT_RSP("+HTTPSRECVDATA:%d,", p_item->data_len);
+                        if (rsp_buf_idx + p_item->data_len < RDU_SERVER_MAX_RECV_DATA_SIZE) {
+                            // copy data to AT_RSP
+                            sys_memcpy((rsp_buf + rsp_buf_idx), p_item->data, p_item->data_len);
+                            rsp_buf_idx += p_item->data_len;
+                        } else {
+                            AT_TRACE("data_len:%d, too long, should not large than %d\r\n", p_item->data_len, RDU_SERVER_MAX_RECV_DATA_SIZE);
+                        }
+                        // AT_TRACE("HTTPSRECVDATA,len:%d\r\n", p_item->data_len);
+                        sys_mfree(p_item->data);
+                        sys_mfree(p_item);
+                    } else {                            // data length is larger than request data length
+                        AT_RSP("+HTTPSRECVDATA:-1,");
+                    }
+                }
+                sys_mutex_put(&send_2_mcu_data_list_lock);
+            } else {
+                AT_RSP("+HTTPSRECVDATA:0,");
+            }
+        }
+    }
+
+    AT_RSP_OK();
+    return;
+
+Error:
+    AT_RSP_ERR();
+    return;
+Usage:
+    AT_RSP("Usage:\r\n");
+    AT_RSP("    +HTTPSRECVDATA=<data_len>\r\n");
+    AT_RSP_OK();
+    return;
+}

+/*!
+    \brief      the AT command start/stop/query a listener for the host
+    \param[in]  argc: number of parameters
+    \param[in]  argv: the pointer to the array that holds the parameters
+    \retval     none
+*/
+void at_tuya_server(int argc, char **argv)
+{
+    uint16_t port = 0;
+    int enable = 1;
+    int slot;
+    char *type = NULL;
+    char *endptr = NULL;
+    uint8_t server_type;
+
+    AT_RSP_START(256);
+    if (argc == 1) {
+        if (argv[0][strlen(argv[0]) - 1] != AT_QUESTION) {
+            goto Error;
+        }
+        for (slot = 0; slot < MAX_SERVER_NUM; slot++) {
+            if (cip_info.srv[slot].fd >= 0) {
+                AT_RSP("+TY553XSERVER2:%s,%u,%d,%u\r\n",
+                       (cip_info.srv[slot].type == CIP_TYPE_TCP) ? "TCP" : "UDP",
+                       (unsigned)cip_info.srv[slot].port, cip_info.srv[slot].fd,
+                       (unsigned)cip_info.srv[slot].generation);
+            }
+        }
+    } else if ((argc == 3) || (argc == 4)) {
+        type = argv[1];
+        if (type[0] == AT_QUESTION) {
+            goto Usage;
+        }
+        if (strncmp(type, "TCP", 3) == 0) {
+            server_type = CIP_TYPE_TCP;
+        } else if (strncmp(type, "UDP", 3) == 0) {
+            server_type = CIP_TYPE_UDP;
+        } else {
+            goto Error;
+        }
+        port = (uint16_t)strtoul(argv[2], &endptr, 10);
+        if ((*endptr != '\0') || (port == 0)) {
+            goto Error;
+        }
+        if (argc == 4) {
+            enable = (int)strtol(argv[3], &endptr, 10);
+            if ((*endptr != '\0') || (enable != 0)) {
+                goto Error;
+            }
+        }
+        if (enable) {
+            slot = tcp_udp_server_start(server_type, port);
+            if (slot < 0) {
+                AT_TRACE("start server failed.\r\n");
+                goto Error;
+            }
+            if ((cip_task_started == 0) || (!sys_task_exist((const uint8_t *)"Cip Rcv"))) {
+                cip_task_started = 0;
+                cip_task_terminate = 0;
+                if (sys_task_create_dynamic((const uint8_t *)"Cip Rcv",
+                                CIP_RECV_STACK_SIZE, CIP_RECV_PRIO,
+                                (task_func_t)cip_recv_task, NULL) == NULL) {
+                    goto Error;
+                }
+                cip_task_started = 1;
+            }
+            if (at_local_sock_wait_ready(500U) < 0) {
+                AT_TRACE("local socket not ready\r\n");
+                goto Error;
+            }
+            AT_RSP("+TY553XSERVER2:%s,%u,%d,%u\r\n",
+                   (server_type == CIP_TYPE_TCP) ? "TCP" : "UDP",
+                   (unsigned)cip_info.srv[slot].port,
+                   cip_info.srv[slot].fd, (unsigned)cip_info.srv[slot].generation);
+        } else {
+            if (tcp_udp_server_stop_port(port) < 0) {
+                goto Error;
+            }
+        }
+    } else {
+        goto Error;
+    }
+
+    AT_RSP_OK();
+    return;
+Error:
+    AT_RSP_ERR();
+    return;
+Usage:
+    AT_RSP("+TY553XSERVER=TCP|UDP,<port>[,0]\r\n");
+    AT_RSP_OK();
+}

-    char sep = AT_SEPARATE;
-
-    if (!ptr)
-        return NULL;
-
-    if (ptr[0] == '\'') {
-        sep = ptr[0];
-        ptr++;
-    }
-
-    next = strchr(ptr, sep);
-    if (next) {
-        *next++ = '\0';
-        while (*next == AT_SPACE)
-            next++;
-        if (*next == '\0')
-            next = NULL;
-    }
-    *params = next;
-    return ptr;

-                goto Error;
-            }
-        }
-        switch (opt) {
-        case FATFS_DELETE:
-            res = fatfs_delete(path);
-            if (res != FR_OK) {
-                goto Error;
-            }
-            break;
-        case FATFS_WRITE:
-            if (argc < 6) {
-                goto Error;
-            } else {
-                file_len = file_size(path);
-                offset = offset < file_len ? offset : file_len;
-                res = at_fatfs_write(path, offset, length);

+static void cip_passth_info_deinit(void)
+{
+    if (cip_passth_info.passth_timer) {
+        sys_timer_delete(&(cip_passth_info.passth_timer));
+    }
+
+    cip_passth_info.terminate_send_passth = 0;
+    cip_passth_info.at_tx_passth_timeout = 0;

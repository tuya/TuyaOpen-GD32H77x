+/*!
+    \brief      parse string
+    \param[in]  param: pointer to a string waiting to be parsed
+    \param[out] none
+    \retval     none
+*/
+char *at_string_parse(char *param)
+{
+    char *find = strchr(param, AT_QUOTE);
+    char *head = NULL, *ptr, *tail = NULL;
+
+    if (find == NULL)
+        return NULL;
+    head = ptr = ++find;
+    while (1) {
+        find = strchr(ptr, AT_QUOTE);
+        if (find == NULL)
+            break;
+        else
+            tail = find;
+        ptr = find + 1;
+    }
+    if (tail != NULL)
+        *tail = '\0';
+    else
+        return NULL;
+    if (*head == '\0')
+        head = NULL;
+    return head;
+}

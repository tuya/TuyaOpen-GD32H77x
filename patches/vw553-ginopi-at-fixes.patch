+static void at_wifi_bridge_mode(int argc, char **argv)
+{
+    char *endptr = NULL;
+    int mode;
+
+    AT_RSP_START(64);
+    if (argc == 1) {
+        if (argv[0][strlen(argv[0]) - 1] == AT_QUESTION) {
+            AT_RSP("+WIFIBRIDGE:%d\r\n", s_at_wifi_bridge_mode);
+        } else {
+            goto Error;
+        }
+    } else if (argc == 2) {
+        if (argv[1][0] == AT_QUESTION) {
+            goto Usage;
+        }
+
+        mode = (int)strtoul((const char *)argv[1], &endptr, 10);
+        if ((*endptr != '\0') || (mode < 0) || (mode > 2)) {
+            goto Error;
+        }
+
+        if (mode == 0) {
+            /* SELF: VW553 keeps IP packets local for association/provisioning. */
+            wifi_bridge_enter_sleep_mode();
+        } else if (mode == 1) {
+            /* BRIDGE: install the Wi-Fi RX hook and forward non-local IP frames to H7 over SPI. */
+            if (mm_spi_init() != 0) {
+                goto Error;
+            }
+            mm_spi_start();
+            wifi_trx_hook_init();
+            if (!wifi_bridge_hook_ready()) {
+                goto Error;
+            }
+        } else {
+            /* TEST: deliver packets both locally and through SPI for bring-up diagnostics. */
+            if (mm_spi_init() != 0) {
+                goto Error;
+            }
+            mm_spi_start();
+            wifi_trx_hook_init();
+            if (!wifi_bridge_hook_ready()) {
+                goto Error;
+            }
+            wifi_bridge_enter_test_mode();
+        }
+        s_at_wifi_bridge_mode = mode;
+    } else {
+        goto Error;
+    }
+
+    AT_RSP_OK();
+    return;
+
+Error:
+    AT_RSP_ERR();
+    return;
+Usage:
+    AT_RSP("+WIFIBRIDGE=<mode:0-2>\r\n");
+    AT_RSP_OK();
+    return;
+}

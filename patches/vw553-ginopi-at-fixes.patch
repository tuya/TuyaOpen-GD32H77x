+        }
+
+        if (mm_spi_set_crc_check((uint8_t)enable) != 0) {
+            goto Error;
+        }
+    } else {
+        goto Error;
+    }
+
+    AT_RSP_OK();
+    return;
+
+Error:
+    AT_RSP_ERR();
+    return;
+Usage:
+    AT_RSP("+SPICRC=<enable:0|1>\r\n");
+    AT_RSP_OK();
+    return;
+}

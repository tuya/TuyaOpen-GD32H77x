+static void at_wifi_mac_query(int argc, char **argv)
+{
+    uint8_t *addr;
+
+    AT_RSP_START(64);
+    if ((argc != 1) || (argv[0][strlen(argv[0]) - 1] != AT_QUESTION)) {
+        goto Usage;
+    }
+
+    addr = wifi_vif_mac_addr_get(WIFI_VIF_INDEX_DEFAULT);
+    if (addr == NULL) {
+        goto Error;
+    }
+
+    AT_RSP("+WIFIMAC:"MAC_FMT"\r\n", MAC_ARG_UINT8(addr));
+    AT_RSP_OK();
+    return;
+
+Error:
+    AT_RSP_ERR();
+    return;
+Usage:
+    AT_RSP("+WIFIMAC?\r\n");
+    AT_RSP_OK();
+    return;
+}

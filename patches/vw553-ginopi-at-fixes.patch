+#else
+            } else if (mode == CIP_TRANS_MODE_FILE_TRANSFER) {
+                cip_info.trans_mode = CIP_TRANS_MODE_FILE_TRANSFER;
+#endif
+            } else {
+                AT_TRACE("Unknown transfer mode:%d\r\n", mode);

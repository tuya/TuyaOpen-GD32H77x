+static void at_uart_prompt_dma_start(uint32_t address, uint32_t num)
+{
+    uint32_t dma_channel;
+
+    sys_sema_down(&at_hw_tx_sema, 0);
+    uart_tx_idle_wait(at_uart_conf.usart_periph);
+
+    uart_config(at_uart_conf.usart_periph, at_uart_conf.baudrate, false, true, false);
+
+    /* The payload DMA is armed as soon as the CIPSEND line has been parsed.
+     * A byte of that line can still sit in the RX FIFO (typically its trailing
+     * LF); the DMA would then record it as the first payload byte and shift the
+     * whole datagram by one byte, which silently corrupts TLS records. The host
+     * only sends the payload after the '>' prompt, so draining now cannot cut a
+     * real payload byte. */
+    while (RESET != usart_flag_get(at_uart_conf.usart_periph, USART_FLAG_RBNE)) {
+        (void)usart_data_receive(at_uart_conf.usart_periph);
+    }
+
+    switch (at_uart_conf.usart_periph) {
+    case USART0:
+        eclic_irq_enable(DMA_Channel2_IRQn, 8, 0);
+        dma_channel = DMA_CH2;
+        break;
+    case UART1:
+        eclic_irq_enable(DMA_Channel0_IRQn, 8, 0);
+        dma_channel = DMA_CH0;
+        break;
+    case UART2:
+    default:
+        eclic_irq_enable(DMA_Channel5_IRQn, 8, 0);
+        dma_channel = DMA_CH5;
+        break;
+    }
+
+    dma_memory_address_config(dma_channel, DMA_MEMORY_0, address);
+    dma_transfer_number_config(dma_channel, num);
+    dma_channel_enable(dma_channel);
+    sys_sema_up(&at_hw_tx_sema);
+}
+
+static void at_uart_prompt_dma_wait(void)
+{
+    sys_sema_down(&at_hw_dma_sema, 0);
+    sys_sema_down(&at_hw_tx_sema, 0);
+    at_hw_dma_receive_stop();
+    usart_dma_receive_config(at_uart_conf.usart_periph, USART_RECEIVE_DMA_DISABLE);
+
+    uart_config(at_uart_conf.usart_periph, at_uart_conf.baudrate, false, false, false);
+    sys_sema_up(&at_hw_tx_sema);
+}

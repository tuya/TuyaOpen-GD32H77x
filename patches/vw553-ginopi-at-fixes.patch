+    } else if (argc == 2) {
+        if (argv[1][0] == AT_QUESTION)
+            goto Usage;
+        else
+            goto Error;
+    } else if (argc == 6) {
+        char *endptr = NULL;
+        cmd.baudrate = (uint32_t)strtoul((const char *)argv[1], &endptr, 10);
+        if (*endptr != '\0') {
+            goto Error;
+        }
+        cmd.databits = (uint32_t)strtoul((const char *)argv[2], &endptr, 10);
+        if (*endptr != '\0') {

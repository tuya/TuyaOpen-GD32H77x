-                            AT_RSP_START(128 + read_len)
-                            AT_RSP("FATFS: read %dBytes, content:\r\n", read_len);
-                            AT_RSP("%s\r\n", (char *)read_buf);
-                            AT_RSP_IMMEDIATE();
-                            AT_RSP_FREE();
-                        } else {
-                            sys_mfree(read_buf);
-                            goto Error;
-                        }
-                        sys_mfree(read_buf);
-                    }
-                }
-            }
-            break;
-        case FATFS_FILE_SIZE:
-            file_len = file_size(path);
-            AT_RSP("%dBytes\r\n", file_len);

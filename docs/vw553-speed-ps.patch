+    at_hw_send(prompt, prompt_size);
+    return at_spi_dma_receive(address, num);
+#else
+    /* Arm DMA before exposing '>' to the host. Otherwise the first payload
+     * bytes can arrive while the UART is still in interrupt-RX mode and are

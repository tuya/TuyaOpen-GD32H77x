 /*!
+    \brief      control station power-save mode
+    \param[in]  argc: number of parameters
+    \param[in]  argv: [mode, dtim], mode 0=off, 1=always-on, 2=traffic-based
+    \param[out] none
+    \retval     none
+*/
+void at_ty553x_ps(int argc, char **argv)
+{
+    uint32_t mode;
+    uint32_t interval;
+    char *endptr = NULL;
+
+    AT_RSP_START(128);
+    if (argc == 2 && argv[1][0] == AT_QUESTION) {
+        goto Usage;
+    }
+    if (argc != 3) {
+        goto Error;
+    }
+
+    mode = (uint32_t)strtoul(argv[1], &endptr, 10);
+    if (*endptr != '\0' || mode > 2U) {
+        goto Error;
+    }
+    interval = (uint32_t)strtoul(argv[2], &endptr, 10);
+    if (*endptr != '\0' || interval > 10U || (mode == 0U && interval != 0U)) {
+        goto Error;
+    }
+
+    if (wifi_netlink_ps_mode_set(WIFI_VIF_INDEX_DEFAULT, (uint8_t)mode) ||
+        wifi_netlink_listen_interval_set((uint8_t)interval)) {
+        goto Error;
+    }
+
+    AT_RSP_OK();
+    return;
+
+Error:
+    AT_RSP_ERR();
+    return;
+Usage:
+    AT_RSP("+TY553XPS=<mode>,<dtim>\r\n");
+    AT_RSP_OK();
+}

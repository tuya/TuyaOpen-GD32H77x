+/* Do not report a listener as started until the receiver has initialized all
+ * of its local sockets and buffers. A task creation success alone is not
+ * enough: the task may immediately fail during setup and close the listener. */
+static int cip_recv_task_start(void)
+{
+    int wait_count;
+
+    if (cip_task_started)
+        return cip_task_start_state == 1 &&
+               sys_task_exist((const uint8_t *)"Cip Rcv") ? 0 : -1;
+
+    cip_task_terminate = 0;
+    cip_task_start_state = 0;
+    if (sys_task_create_dynamic((const uint8_t *)"Cip Rcv", CIP_RECV_STACK_SIZE,
+                                CIP_RECV_PRIO, (task_func_t)cip_recv_task, NULL) == NULL) {
+        cip_task_start_state = -1;
+        return -1;
+    }
+    cip_task_started = 1;
+    for (wait_count = 0; wait_count < 500; wait_count++) {
+        if (cip_task_start_state != 0)
+            break;
+        if (!sys_task_exist((const uint8_t *)"Cip Rcv"))
+            break;
+        sys_ms_sleep(1);
+    }
+    if (cip_task_start_state == 1 &&
+        sys_task_exist((const uint8_t *)"Cip Rcv"))
+        return 0;
+
+    cip_task_terminate = 1;
+    while (sys_task_exist((const uint8_t *)"Cip Rcv"))
+        sys_ms_sleep(1);
+    cip_task_started = 0;
+    return -1;
 }
 

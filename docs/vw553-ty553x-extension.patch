+void at_ty553x_cap(int argc, char **argv)
+{
+    AT_RSP_START(128);
+    if (argc != 1 || argv[0][strlen(argv[0]) - 1] != AT_QUESTION) {
+        AT_RSP_ERR();
+        return;
+    }
+    AT_RSP("+TY553XCAP:1,ATOMIC_IPD,DUAL_SERVER,TCP_ACCEPT,UDP_SEND_ID=%d,MAX_SEND=%d,MAX_CLIENTS=%d\r\n",
+           MAX_CLIENT_NUM, 2048, MAX_CLIENT_NUM);
+    AT_RSP_OK();
+}
+
+void at_ty553x_server(int argc, char **argv)
+{
+    char *type;
+    char *endptr = NULL;
+    uint32_t parsed_port;
+    uint8_t cip_type;
+    int slot;
+
+    AT_RSP_START(256);
+    if (argc == 1 && argv[0][strlen(argv[0]) - 1] == AT_QUESTION) {
+        int i;
+        for (i = 0; i < 2; i++) {
+            if (cip_info.local_srv_fd[i] >= 0) {
+                AT_RSP("+TY553XSERVER:%s,%u,%d\r\n",
+                       cip_info.local_srv_type[i] == CIP_TYPE_TCP ? "TCP" : "UDP",
+                       cip_info.local_srv_port[i], cip_info.local_srv_fd[i]);
+            }
+        }
+        AT_RSP_OK();
+        return;
+    }
+    if (argc != 3 || multi_connection_enable == 0) {
+        goto Error;
+    }
+    type = at_string_parse(argv[1]);
+    if (type == NULL)
+        goto Error;
+    if (strncmp(type, "TCP", 4) == 0)
+        cip_type = CIP_TYPE_TCP;
+    else if (strncmp(type, "UDP", 4) == 0)
+        cip_type = CIP_TYPE_UDP;
+    else
+        goto Error;
+    parsed_port = strtoul((const char *)argv[2], &endptr, 10);
+    if (endptr == argv[2] || *endptr != '\0' || parsed_port > 65535)
+        goto Error;
+    if (parsed_port == 0) {
+        slot = cip_server_find(cip_type);
+        if (slot < 0)
+            goto Error;
+        ty553x_server_mode = 1;
+        if (tcp_udp_server_stop(cip_type) < 0)
+            goto Error;
+        if (cip_server_count() == 0)
+            ty553x_server_mode = 0;
+        AT_RSP_OK();
+        return;
+    }
+    if (parsed_port < 1 || cip_server_find(cip_type) >= 0 || cip_server_free_slot() < 0)
+        goto Error;
+    if (tcp_udp_server_start(cip_type, (uint16_t)parsed_port) < 0)
+        goto Error;
+    ty553x_server_mode = 1;
+    if (cip_recv_task_start() < 0) {
+        tcp_udp_server_stop(cip_type);
+        if (cip_server_count() == 0)
+            ty553x_server_mode = 0;
+        goto Error;
+    }
+    slot = cip_server_find(cip_type);
+    if (slot < 0 || cip_info.local_srv_stop[slot]) {
+        if (cip_server_count() == 0)
+            ty553x_server_mode = 0;
+        goto Error;
+    }
+    AT_RSP("+TY553XSERVER:%s,%u,%d\r\n", cip_type == CIP_TYPE_TCP ? "TCP" : "UDP",
+           cip_info.local_srv_port[slot], cip_info.local_srv_fd[slot]);
+    AT_RSP_OK();
+    return;
+
+Error:
+    AT_RSP_ERR();
 }
 

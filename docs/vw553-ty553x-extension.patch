+#ifndef CONFIG_ATCMD_SPI
+/* Keep one unsolicited IPD header, payload, and trailer indivisible on UART. */
+void at_hw_send_ipd(char *header, int header_size, char *payload, int payload_size)
+{
+    static char trailer[] = "\r\nOK\r\n";
+
+    sys_sema_down(&at_hw_tx_sema, 0);
+    if (header_size > 0) {
+        at_uart_send_unlocked(header, header_size);
+    }
+    if (payload_size > 0) {
+        at_uart_send_unlocked(payload, payload_size);
+    }
+    at_uart_send_unlocked(trailer, sizeof(trailer) - 1);
+    sys_sema_up(&at_hw_tx_sema);
+}

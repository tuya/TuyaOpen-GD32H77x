# TuyaOS adapter selection for the GD32H77X platform.
# Keep this capability profile separate from application/project options.
CONFIG_OPERATING_SYSTEM=98
CONFIG_ENABLE_ADC=n
CONFIG_ENABLE_ASR=n
CONFIG_ENABLE_BLUETOOTH=y
CONFIG_ENABLE_DAC=n
CONFIG_ENABLE_DISPLAY=n
CONFIG_ENABLE_FILE_SYSTEM=n
CONFIG_ENABLE_GPIO=n
CONFIG_ENABLE_HCI=n
CONFIG_ENABLE_I2C=n
CONFIG_ENABLE_I2S=n
CONFIG_MCU8080=n
CONFIG_ENABLE_MEDIA=n
CONFIG_ENABLE_PINMUX=n
CONFIG_ENABLE_PM=n
CONFIG_ENABLE_PWM=n
CONFIG_ENABLE_QSPI=n
CONFIG_ENABLE_REGISTER=n
CONFIG_ENABLE_RGB=n
CONFIG_ENABLE_RTC=n
CONFIG_ENABLE_SPI=n
CONFIG_ENABLE_STORAGE=n
CONFIG_ENABLE_PLATFORM_AES=n
CONFIG_ENABLE_PLATFORM_ECC=n
CONFIG_ENABLE_PLATFORM_RSA=n
CONFIG_ENABLE_PLATFORM_SHA1=n
CONFIG_ENABLE_PLATFORM_SHA256=n
CONFIG_ENABLE_TIMER=n
CONFIG_ENABLE_UART=y
CONFIG_ENABLE_VAD=n
CONFIG_ENABLE_WAKEUP=n
CONFIG_ENABLE_WATCHDOG=n
CONFIG_ENABLE_WIFI=y
CONFIG_ENABLE_WIRED=n

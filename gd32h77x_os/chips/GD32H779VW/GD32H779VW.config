# Default flashing backend. Device selection is automatic; -p overrides it.
CONFIG_ENABLE_GD32H77X_FLASH_BACKEND_SWD=y

# Console: USART5 on PC6/PC7, AF7.
CONFIG_ENABLE_GD32H77X_CONSOLE_UART_USART5=y
CONFIG_ENABLE_GD32H77X_CONSOLE_GPIO_PORT_C=y
CONFIG_GD32H77X_CONSOLE_TX_PIN_NUMBER=6
CONFIG_GD32H77X_CONSOLE_RX_PIN_NUMBER=7
CONFIG_GD32H77X_CONSOLE_AF_NUMBER=7

# AT: UART4 on PB13/PB12, AF14; NRST on PC5.
CONFIG_ENABLE_GD32H77X_AT_UART_UART4=y
CONFIG_ENABLE_GD32H77X_AT_GPIO_PORT_B=y
CONFIG_GD32H77X_AT_TX_PIN_NUMBER=13
CONFIG_GD32H77X_AT_RX_PIN_NUMBER=12
CONFIG_GD32H77X_AT_AF_NUMBER=14
CONFIG_GD32H77X_AT_BAUD=115200
CONFIG_GD32H77X_AT_IRQ_PRIORITY=6
CONFIG_ENABLE_GD32H77X_AT_RESET_GPIO_PORT_C=y
CONFIG_GD32H77X_AT_RESET_PIN_NUMBER=5

# Runtime inputs:
#   tos.py flash -p: explicit UART port, SWD probe ID or DFU USB path
#   tos.py flash -b: UART baud rate (auto when omitted)
#   GD32H77X_DFP_PACK: required CMSIS-Pack path for SWD

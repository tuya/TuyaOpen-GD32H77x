set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(DEFINED ENV{GD32H77X_TOOLCHAIN} AND NOT "$ENV{GD32H77X_TOOLCHAIN}" STREQUAL "")
    set(_gd32_bin "$ENV{GD32H77X_TOOLCHAIN}/bin")
endif()
if(NOT DEFINED _gd32_bin)
    # Match platform_prepare.py: accept the documented /opt installation when
    # the environment override and PATH do not provide one.
    file(GLOB _gd32_opt_bins "/opt/gcc-arm-none-eabi-*/bin")
endif()
find_program(_gd32_gcc arm-none-eabi-gcc HINTS "${_gd32_bin}" ${_gd32_opt_bins} REQUIRED)
get_filename_component(_gd32_bin "${_gd32_gcc}" DIRECTORY)
foreach(_pair C:gcc CXX:g++ ASM:gcc)
    string(REPLACE ":" ";" _parts "${_pair}")
    list(GET _parts 0 _language)
    list(GET _parts 1 _tool)
    set(CMAKE_${_language}_COMPILER "${_gd32_bin}/arm-none-eabi-${_tool}")
endforeach()
set(CMAKE_AR "${_gd32_bin}/arm-none-eabi-ar")
set(CMAKE_RANLIB "${_gd32_bin}/arm-none-eabi-ranlib")
set(CMAKE_OBJCOPY "${_gd32_bin}/arm-none-eabi-objcopy")
set(CMAKE_SIZE "${_gd32_bin}/arm-none-eabi-size")
set(_gd32_flags "-mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=softfp -ffunction-sections -fdata-sections -Os -g3")
set(CMAKE_C_FLAGS "${_gd32_flags}")
set(CMAKE_CXX_FLAGS "${_gd32_flags} -fno-exceptions -fno-rtti")
set(CMAKE_ASM_FLAGS "${_gd32_flags}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)


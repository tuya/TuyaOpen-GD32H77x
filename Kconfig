    config ENABLE_GD32H77X_AT_UART_USART1
        bool "USART1"
    config ENABLE_GD32H77X_AT_UART_USART2
        bool "USART2"
    config ENABLE_GD32H77X_AT_UART_UART3
        bool "UART3"
    config ENABLE_GD32H77X_AT_UART_UART4
        bool "UART4"
    config ENABLE_GD32H77X_AT_UART_USART5
        bool "USART5"
    config ENABLE_GD32H77X_AT_UART_UART6
        bool "UART6"
    config ENABLE_GD32H77X_AT_UART_UART7
        bool "UART7"

    int "Console RX pin"
    range 0 15
    default 7
    help
      GPIO pin number on the selected console GPIO port.

config GD32H77X_CONSOLE_AF_NUMBER
    int "Console alternate function"
    range 0 31
    default 7
    help
      GD32 alternate-function number used by both console pins.

endmenu

menu "AT transport binding"

choice
    prompt "AT transport"
    default ENABLE_GD32H77X_AT_TRANSPORT_UART

    config ENABLE_GD32H77X_AT_TRANSPORT_UART
        bool "UART AT transport"

    config ENABLE_GD32H77X_AT_TRANSPORT_SPI
        bool "SPI AT transport"
endchoice

choice
    prompt "AT SPI clock prescaler"
    default ENABLE_GD32H77X_AT_SPI_PSC_256

    config ENABLE_GD32H77X_AT_SPI_PSC_16
        bool "/16 (18.75 MHz on 300 MHz PLL0Q)"
    config ENABLE_GD32H77X_AT_SPI_PSC_64
        bool "/64"
    config ENABLE_GD32H77X_AT_SPI_PSC_128
        bool "/128"
    config ENABLE_GD32H77X_AT_SPI_PSC_256
        bool "/256 (slow and conservative)"
endchoice

config ENABLE_GD32H77X_AT_SPI_CS_ONLY
    bool "SPI AT v2: active-low CS polling, without READY"
    depends on ENABLE_GD32H77X_AT_TRANSPORT_SPI
    default n
    help
      Requires matching VW553 CS_ONLY firmware. The old REQUEST pin becomes
      active-low CS; READY is neither configured nor sampled. Version 2 frames
      prevent accidentally communicating with the legacy READY-based peer.

config GD32H77X_AT_SPI_NUMBER
    int "AT SPI controller (0..5)"
    range 0 5
    default 3
    help
      Signal routes are checked against at_routes.py during configuration
      generation. AF, clock source, reset gate and DMA requests are derived.

config GD32H77X_AT_SPI_SCK
    string "AT SPI SCK route (e.g. PB13)"
    default "PE2"
    help
      Ordinary-pad name from the verified controller routing catalogue.
      Invalid routes and H779 package conflicts stop the build before compile.

config GD32H77X_AT_SPI_MISO
    string "AT SPI MISO route (e.g. PB14)"
    default "PE5"

config GD32H77X_AT_SPI_MOSI
    string "AT SPI MOSI route (e.g. PB15)"
    default "PE6"

config GD32H77X_AT_SPI_CS
    string "AT SPI active-low CS GPIO"
    default "PE4"

config GD32H77X_AT_SPI_READY
    string "AT SPI READY GPIO (legacy protocol only)"
    default "PE3"


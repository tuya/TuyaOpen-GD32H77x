# GD32H77X platform-owned configuration.
#
# Parsed by platform_config.py to generate gd32h77x_config.h and
# gd32h77x_config.cmake.
menu "configure platform [GD32H77X]"

choice
    prompt "Default flashing backend"
    default ENABLE_GD32H77X_FLASH_BACKEND_SWD

    config ENABLE_GD32H77X_FLASH_BACKEND_SWD
        bool "swd"
        help
          CMSIS-DAP with the GigaDevice GD32H77x CMSIS-Pack.

    config ENABLE_GD32H77X_FLASH_BACKEND_DFU
        bool "dfu"
        help
          GD32 ROM USB DFU.

    config ENABLE_GD32H77X_FLASH_BACKEND_UART
        bool "uart"
        help
          GD32 ROM system-memory UART ISP.
endchoice

config ENABLE_GD32H77X_FLASH_DFU_AUTOSTART
    bool "Start application after successful DFU flashing"
    depends on ENABLE_GD32H77X_FLASH_BACKEND_DFU
    default n
    help
      Send the ROM DfuSe leave command after programming and verification.
      BOOT must be low for subsequent hardware resets to start the application.

config GD32H77X_PMU_SMPS_MODE
    string "VCORE PMU supply mode"
    default ""
    help
      Board power-topology selector. Leave empty to preserve the vendor
      reset/default PMU configuration. Use "bypass" when VCORE is supplied by
      an external regulator and the internal SMPS is not used; use "direct"
      when the internal SMPS supplies VCORE.

config ENABLE_GD32H77X_POWER_HOLD
    bool "Assert power hold GPIO during early platform initialization"
    default n

config GD32H77X_POWER_HOLD_GPIO
    string "Power hold GPIO"
    depends on ENABLE_GD32H77X_POWER_HOLD
    default "PC13"

config ENABLE_GD32H77X_POWER_HOLD_ACTIVE_HIGH
    bool "Power hold is active high"
    depends on ENABLE_GD32H77X_POWER_HOLD
    default y


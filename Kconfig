    prompt "AT UART GPIO port"
    default ENABLE_GD32H77X_AT_GPIO_PORT_B

    config ENABLE_GD32H77X_AT_GPIO_PORT_A
        bool "GPIOA"
    config ENABLE_GD32H77X_AT_GPIO_PORT_B
        bool "GPIOB"
    config ENABLE_GD32H77X_AT_GPIO_PORT_C
        bool "GPIOC"
    config ENABLE_GD32H77X_AT_GPIO_PORT_D
        bool "GPIOD"
    config ENABLE_GD32H77X_AT_GPIO_PORT_E

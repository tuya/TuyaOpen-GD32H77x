# GD32H77X platform-owned configuration.
#
# Parsed by platform_config.py to generate gd32h77x_config.h and
# gd32h77x_config.cmake.
menu "configure platform [GD32H77X]"

choice
    prompt "Default flashing backend"
    default ENABLE_GD32H77X_FLASH_BACKEND_SWD

    config ENABLE_GD32H77X_FLASH_BACKEND_SWD
        bool "swd"
        help
          CMSIS-DAP with the GigaDevice GD32H77x CMSIS-Pack.

    config ENABLE_GD32H77X_FLASH_BACKEND_DFU
        bool "dfu"
        help
          GD32 ROM USB DFU.

    config ENABLE_GD32H77X_FLASH_BACKEND_UART
        bool "uart"
        help
          GD32 ROM system-memory UART ISP.
endchoice

config GD32H77X_PMU_SMPS_MODE
    string "VCORE PMU supply mode"
    default ""
    help
      Board power-topology selector. Leave empty to preserve the vendor
      reset/default PMU configuration. Use "bypass" when VCORE is supplied by
      an external regulator and the internal SMPS is not used; use "direct"
      when the internal SMPS supplies VCORE.

menu "Console UART binding"

choice
    prompt "Console UART peripheral"
    default ENABLE_GD32H77X_CONSOLE_UART_USART5

    config ENABLE_GD32H77X_CONSOLE_UART_USART0
        bool "USART0"
    config ENABLE_GD32H77X_CONSOLE_UART_USART1
        bool "USART1"
    config ENABLE_GD32H77X_CONSOLE_UART_USART2
        bool "USART2"
    config ENABLE_GD32H77X_CONSOLE_UART_UART3
        bool "UART3"
    config ENABLE_GD32H77X_CONSOLE_UART_UART4
        bool "UART4"
    config ENABLE_GD32H77X_CONSOLE_UART_USART5
        bool "USART5"
    config ENABLE_GD32H77X_CONSOLE_UART_UART6
        bool "UART6"
    config ENABLE_GD32H77X_CONSOLE_UART_UART7
        bool "UART7"
endchoice

choice
    prompt "Console GPIO port"
    default ENABLE_GD32H77X_CONSOLE_GPIO_PORT_C

    config ENABLE_GD32H77X_CONSOLE_GPIO_PORT_A
        bool "GPIOA"
    config ENABLE_GD32H77X_CONSOLE_GPIO_PORT_B
        bool "GPIOB"
    config ENABLE_GD32H77X_CONSOLE_GPIO_PORT_C
        bool "GPIOC"
    config ENABLE_GD32H77X_CONSOLE_GPIO_PORT_D
        bool "GPIOD"
    config ENABLE_GD32H77X_CONSOLE_GPIO_PORT_E
        bool "GPIOE"
    config ENABLE_GD32H77X_CONSOLE_GPIO_PORT_F
        bool "GPIOF"
    config ENABLE_GD32H77X_CONSOLE_GPIO_PORT_G
        bool "GPIOG"
    config ENABLE_GD32H77X_CONSOLE_GPIO_PORT_H
        bool "GPIOH"
    config ENABLE_GD32H77X_CONSOLE_GPIO_PORT_J
        bool "GPIOJ"
    config ENABLE_GD32H77X_CONSOLE_GPIO_PORT_K
        bool "GPIOK"
endchoice

config GD32H77X_CONSOLE_TX_PIN_NUMBER
    int "Console TX pin"
    range 0 15
    default 6
    help
      GPIO pin number on the selected console GPIO port.

config GD32H77X_CONSOLE_RX_PIN_NUMBER
    int "Console RX pin"
    range 0 15
    default 7
    help
      GPIO pin number on the selected console GPIO port.

config GD32H77X_CONSOLE_AF_NUMBER
    int "Console alternate function"
    range 0 31
    default 7
    help
      GD32 alternate-function number used by both console pins.

endmenu

menu "AT UART binding"


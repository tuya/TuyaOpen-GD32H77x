menu "External PSRAM"

config ENABLE_GD32H77X_PSRAM
    bool "Enable external PSRAM on OSPI0"
    default n
    help
      Enable the GD32H77X OSPI0 PSRAM controller, device profile and TKL
      PSRAM heap. Boards without PSRAM must leave this disabled.

config GD32H77X_PSRAM_PROFILE
    string "PSRAM device profile"
    depends on ENABLE_GD32H77X_PSRAM
    default "APS6404L-3SQR"
    help
      Verified PSRAM profile name. The profile owns device-specific commands,
      reset sequence, dummy cycles and timing limits.

choice
    prompt "PSRAM access mode"
    depends on ENABLE_GD32H77X_PSRAM
    default GD32H77X_PSRAM_ACCESS_INDIRECT

    config GD32H77X_PSRAM_ACCESS_INDIRECT
        bool "indirect"
        help
          Access PSRAM only through the explicit offset-based read/write API.
          The OSPI memory-mapped window stays disabled. This mode supports
          arbitrary byte offsets and lengths at the cost of CPU-polled copies.

    config GD32H77X_PSRAM_ACCESS_MAPPED
        bool "memory-mapped"
        help
          Enter the OSPI memory-mapped window. This requires every access path
          to satisfy the device and Cortex-M7 mapping constraints and is not
          yet accepted for a general-purpose PSRAM heap on this board.
endchoice

choice
    prompt "PSRAM OSPIM port"
    depends on ENABLE_GD32H77X_PSRAM
    default GD32H77X_PSRAM_OSPIM_PORT0

    config GD32H77X_PSRAM_OSPIM_PORT0
        bool "OSPIM Port 0"

    config GD32H77X_PSRAM_OSPIM_PORT1
        bool "OSPIM Port 1"
endchoice

config GD32H77X_PSRAM_CS_PIN
    string "PSRAM CS pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""

config GD32H77X_PSRAM_SCK_PIN
    string "PSRAM SCK pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""

config GD32H77X_PSRAM_IO0_PIN
    string "PSRAM IO0 pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""

config GD32H77X_PSRAM_IO1_PIN
    string "PSRAM IO1 pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""

config GD32H77X_PSRAM_IO2_PIN
    string "PSRAM IO2 pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""

config GD32H77X_PSRAM_IO3_PIN
    string "PSRAM IO3 pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""

config GD32H77X_PSRAM_IO4_PIN
    string "PSRAM IO4 pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""
    help
      Required for eight-line PSRAM profiles. Leave empty for four-line devices.

config GD32H77X_PSRAM_IO5_PIN
    string "PSRAM IO5 pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""
    help
      Required for eight-line PSRAM profiles. Leave empty for four-line devices.

config GD32H77X_PSRAM_IO6_PIN
    string "PSRAM IO6 pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""
    help
      Required for eight-line PSRAM profiles. Leave empty for four-line devices.

config GD32H77X_PSRAM_IO7_PIN
    string "PSRAM IO7 pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""
    help
      Required for eight-line PSRAM profiles. Leave empty for four-line devices.

config GD32H77X_PSRAM_DQS_PIN
    string "PSRAM DQS pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""
    help
      Required for DQS-gated eight-line PSRAM profiles.

config GD32H77X_PSRAM_RESET_PIN
    string "PSRAM hardware reset pin"
    depends on ENABLE_GD32H77X_PSRAM
    default ""
    help
      Optional active-low PSRAM hardware reset GPIO. Leave empty when the
      device reset pin is tied high or not connected.

config GD32H77X_PSRAM_CLOCK_HZ
    int "PSRAM clock in Hz"
    depends on ENABLE_GD32H77X_PSRAM
    range 1000000 133000000
    default 75000000

config GD32H77X_PSRAM_SIZE_MB
    int "PSRAM capacity in MiB"
    depends on ENABLE_GD32H77X_PSRAM
    range 1 64
    default 8

config GD32H77X_PSRAM_HEAP_OFFSET_KB
    int "PSRAM runtime heap offset in KiB"
    depends on ENABLE_GD32H77X_PSRAM
    range 0 65536
    default 4096

config GD32H77X_PSRAM_HEAP_SIZE_KB
    int "PSRAM runtime heap size in KiB"
    depends on ENABLE_GD32H77X_PSRAM
    range 1 65536
    default 4096

endmenu

endmenu

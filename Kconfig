    int "Legacy AT UART alternate function (ignored by explicit routes)"
    range 0 31
    default 14
    help
      GD32 alternate-function number used by both AT UART pins.

config GD32H77X_AT_UART_TX_ROUTE
    string "AT UART TX route (empty uses legacy GPIO settings)"
    default ""
    help
      Enter a datasheet pin name such as PA9. AF is derived automatically.
      TX and RX may use different GPIO ports and AF numbers.

config GD32H77X_AT_UART_RX_ROUTE
    string "AT UART RX route (empty uses legacy GPIO settings)"
    default ""

config GD32H77X_AT_BAUD
    int "AT UART baud rate"
    range 1200 4000000
    default 115200

config GD32H77X_AT_IRQ_PRIORITY
    int "AT UART IRQ priority"
    range 5 15
    default 6
    help
      Must remain at or below the FreeRTOS maximum syscall priority.

config ENABLE_GD32H77X_AT_SHARED_RESET
    bool "AT module reset is connected to the host reset"
    default n
    help
      Disable module GPIO reset pulses when they would reset the host too.


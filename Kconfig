config GD32H77X_AT_TX_PIN_NUMBER
    int "AT TX pin"
    range 0 15
    default 13
    help
      GPIO pin number on the selected AT UART GPIO port.

config GD32H77X_AT_RX_PIN_NUMBER
    int "AT RX pin"
    range 0 15
    default 12
    help
      GPIO pin number on the selected AT UART GPIO port.

config GD32H77X_AT_AF_NUMBER
    int "AT UART alternate function"
    range 0 31
    default 14
    help
      GD32 alternate-function number used by both AT UART pins.

config GD32H77X_AT_BAUD
    int "AT UART baud rate"
    range 1200 4000000
    default 115200

config GD32H77X_AT_IRQ_PRIORITY
    int "AT UART IRQ priority"
    range 5 15
    default 6
    help
      Must remain at or below the FreeRTOS maximum syscall priority.

choice
    prompt "AT reset GPIO port"
    default ENABLE_GD32H77X_AT_RESET_GPIO_PORT_C

    config ENABLE_GD32H77X_AT_RESET_GPIO_PORT_A
        bool "GPIOA"
    config ENABLE_GD32H77X_AT_RESET_GPIO_PORT_B
        bool "GPIOB"
    config ENABLE_GD32H77X_AT_RESET_GPIO_PORT_C
        bool "GPIOC"
    config ENABLE_GD32H77X_AT_RESET_GPIO_PORT_D
        bool "GPIOD"
    config ENABLE_GD32H77X_AT_RESET_GPIO_PORT_E
        bool "GPIOE"
    config ENABLE_GD32H77X_AT_RESET_GPIO_PORT_F
        bool "GPIOF"
    config ENABLE_GD32H77X_AT_RESET_GPIO_PORT_G
        bool "GPIOG"
    config ENABLE_GD32H77X_AT_RESET_GPIO_PORT_H
        bool "GPIOH"
    config ENABLE_GD32H77X_AT_RESET_GPIO_PORT_J
        bool "GPIOJ"
    config ENABLE_GD32H77X_AT_RESET_GPIO_PORT_K
        bool "GPIOK"
endchoice

config GD32H77X_AT_RESET_PIN_NUMBER
    int "AT reset pin"
    range 0 15
    default 5
    help
      GPIO pin number on the selected AT reset GPIO port.

endmenu

